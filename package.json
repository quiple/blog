{
  "name": "blog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "VITE_PRERENDER_OG_IMAGES=true vite build",
    "build:fast": "vite build",
    "preview": "wrangler pages dev ./.svelte-kit/cloudflare",
    "deploy": "VITE_PRERENDER_OG_IMAGES=true vite build && wrangler deploy",
    "deploy:fast": "vite build && wrangler deploy",
    "prepare": "lefthook install",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "sync-images": "node scripts/sync-image-sizes.ts",
    "obfuscate-fonts": "node scripts/obfuscate-fonts.ts"
  },
  "devDependencies": {
    "@ethercorps/sveltekit-og": "github:quiple/sveltekit-og",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.35.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lefthook": "^2.1.12",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rehype-external-links": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-alerts": "github:quiple/remark-github-alerts",
    "remark-mdx": "^3.1.1",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "github:quiple/remark-smartypants",
    "shadcn-svelte": "^1.5.1",
    "sharp": "^0.35.4",
    "strip-markdown": "^6.0.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "valibot": "^1.4.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "imports": {
    "#app.css": "./src/app.css",
    "#fonts.css": "./src/fonts.css"
  },
  "dependencies": {
    "@giscus/svelte": "^3.1.0",
    "@quiple/aster": "^1.0.5",
    "bdfparser": "^2.2.5",
    "fetchline": "^1.0.1",
    "inter-ui": "^4.1.1"
  }
}
