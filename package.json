{
  "name": "blog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler pages dev ./.svelte-kit/cloudflare",
    "deploy": "pnpm run build && wrangler deploy",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "oxlint --type-aware",
    "img": "sharp -i ./src/lib/assets/article/*.* -o ./static/img/article -f avif -q 50",
    "thumb": "sharp -i ./src/lib/assets/thumbnail/*.* -o ./static/img/thumbnail resize --height 240 -f avif -q 50"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@ibm/plex-sans-jp": "^3.0.0",
    "@ibm/plex-sans-kr": "^1.1.0",
    "@internationalized/date": "^3.10.1",
    "@lucide/svelte": "^0.562.0",
    "@prettier/plugin-oxc": "^0.1.3",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.49.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mdast": "^4.0.4",
    "bits-ui": "^2.15.4",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.3",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "mode-watcher": "^1.1.0",
    "non.geist": "github:quiple/non.geist",
    "oxlint": "^1.38.0",
    "oxlint-tsgolint": "^0.10.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rehype-external-links": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-cjk-friendly": "^1.2.3",
    "remark-cjk-friendly-gfm-strikethrough": "^1.2.3",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-alerts": "github:quiple/remark-github-alerts",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "github:quiple/remark-smartypants",
    "sass": "^1.97.2",
    "sharp-cli": "^5.2.0",
    "strip-markdown": "^6.0.0",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "sveltekit-view-transition": "^0.5.3",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0",
    "valibot": "^1.2.0",
    "vite": "^7.3.1",
    "wrangler": "^4.58.0"
  },
  "lint-staged": {
    "**/*": "prettier --write . --ignore-unknown"
  },
  "imports": {
    "#app.css": "./src/app.css",
    "#fonts.sass": "./src/fonts.sass"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "remark-github-alerts"
    ]
  }
}
