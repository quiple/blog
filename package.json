{
  "name": "blog",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "licenses": "node scripts/license-notices.mjs",
    "dev": "vite dev",
    "import": "node --env-file-if-exists=.env.local import.ts",
    "diff": "node diff.ts",
    "build": "VITE_PRERENDER_OG_IMAGES=true vite build",
    "build:fast": "vite build",
    "preview": "wrangler pages dev ./.svelte-kit/cloudflare",
    "deploy": "VITE_PRERENDER_OG_IMAGES=true vite build && wrangler deploy",
    "deploy:fast": "vite build && wrangler deploy",
    "prepare": "lefthook install",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:import": "tsc --project scripts/lyrics/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "sync-images": "node --env-file-if-exists=.env.local scripts/sync-image-sizes.ts",
    "obfuscate-fonts": "node scripts/obfuscate-fonts.ts",
    "pron": "node pron.ts",
    "conv": "node conv.ts",
    "ttml": "node ttml.ts"
  },
  "devDependencies": {
    "@applemusic-like-lyrics/ttml": "1.0.1",
    "@ethercorps/sveltekit-og": "github:quiple/sveltekit-og",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.2",
    "@xmldom/xmldom": "0.9.12",
    "bits-ui": "^2.19.3",
    "gray-matter": "^4.0.3",
    "lefthook": "^2.1.14",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "rehype-external-links": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-alerts": "0.1.1",
    "remark-mdx": "^3.1.1",
    "remark-rehype": "^11.1.2",
    "remark-ruby": "^0.4.0",
    "remark-smartypants": "github:quiple/remark-smartypants",
    "shadcn-svelte": "^1.7.0",
    "sharp": "^0.35.4",
    "simple-icons": "^16.32.0",
    "strip-markdown": "^6.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.1",
    "wrangler": "^4.138.0"
  },
  "imports": {
    "#app.css": "./src/app.css",
    "#fonts.css": "./src/fonts.css"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.6.0",
    "@giscus/svelte": "^3.1.0",
    "@quiple/aster": "^1.0.15",
    "bdfparser": "^2.2.5",
    "cn": "^0.4.0",
    "inter-ui": "^4.1.1",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.0",
      "onFail": "ignore"
    }
  }
}
