{
  "name": "blog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler pages dev ./.svelte-kit/cloudflare",
    "deploy": "vite build && wrangler deploy",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "devDependencies": {
    "@ethercorps/sveltekit-og": "github:quiple/sveltekit-og",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.8.0",
    "@prettier/plugin-oxc": "^0.1.3",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.12",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.6.0",
    "bits-ui": "^2.17.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.5.11",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "mode-watcher": "^1.1.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.20.0",
    "prettier": "^3.8.2",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rehype-external-links": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-cjk-friendly": "^2.0.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-alerts": "github:quiple/remark-github-alerts",
    "remark-mdx": "^3.1.1",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "github:quiple/remark-smartypants",
    "sass": "^1.99.0",
    "shadcn-svelte": "^1.2.7",
    "sharp-cli": "^5.2.0",
    "strip-markdown": "^6.0.0",
    "svelte": "^5.55.3",
    "svelte-check": "^4.4.6",
    "svelte-toc": "^0.6.3",
    "sveltekit-view-transition": "^0.5.3",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "unist-util-visit": "^5.1.0",
    "valibot": "^1.3.1",
    "vite": "^8.0.8",
    "wrangler": "^4.81.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun lint",
    "*": "prettier --write . --ignore-unknown"
  },
  "imports": {
    "#app.css": "./src/app.css",
    "#fonts.sass": "./src/fonts.sass"
  },
  "dependencies": {
    "bdfparser": "^2.2.5",
    "fetchline": "^1.0.1",
    "skia-canvas": "^3.0.8"
  }
}
