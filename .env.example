# Copy to .env.local for Vite development and nub run sync-images.
# Production: configure this as a Cloudflare Worker Secret.
INTERNAL_IMAGE_SECRET=

# Local lyric import only. Copy values from your own logged-in web player.
SPOTIFY_ACCESS_TOKEN=
APPLE_MUSIC_TOKEN=
APPLE_MUSIC_USER_TOKEN=
# Optional: defaults to the Apple Music account storefront.
APPLE_MUSIC_STOREFRONT=
